{
  "name": "board-forge",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "board-forge",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.6.0"
      },
      "engines": {
        "node": ">=22.13"
      }
    },
    "apps/worker": {
      "name": "@board-forge/worker",
      "dependencies": {
        "@board-forge/types": "*"
      }
    },
    "node_modules/@board-forge/types": {
      "resolved": "packages/types",
      "link": true
    },
    "node_modules/@board-forge/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/types": {
      "name": "@board-forge/types"
    }
  }
}
