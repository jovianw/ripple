{
  "name": "ripple",
  "private": true,
  "engines": { "node": ">=22.13" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc -b packages/types apps/worker && tsc -p scripts",
    "setup:indexes": "tsx --env-file-if-exists=.env scripts/setup-indexes.ts",
    "green": "tsx --env-file-if-exists=.env scripts/green-check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "^5.6.0"
  }
}
