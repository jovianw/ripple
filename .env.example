# Copy to .env and fill in. Never commit .env.

# Atlas Hackathon Sandbox cluster (Connect -> Drivers)
MONGODB_URI=                 # ripple_writer (readWrite on ripple), worker only
MONGODB_URI_READER=          # ripple_reader (read on ripple), web + MCP server
MONGODB_DB=ripple
MDB_MCP_CONNECTION_STRING=   # same as MONGODB_URI_READER; the MCP server only reads this name

# Models (OpenRouter). The harness config routes each agent to a tier.
OPENROUTER_API_KEY=
MODEL_CHEAP=google/gemini-3.8-flash
MODEL_STRONG=anthropic/claude-opus-5.5

# Embeddings and rerank (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_DIMS=1024
VOYAGE_RERANK_MODEL=rerank-2.5

# Tracing (LangSmith). Tracing stays off without LANGSMITH_TRACING=true.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ripple
