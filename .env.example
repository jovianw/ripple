MONGODB_URI=mongodb+srv://ripple_writer:<password>@cluster0.y1ea4k.mongodb.net/?appName=Cluster0   # writer, worker only
MONGODB_URI_READER=mongodb+srv://ripple_reader:<password>@cluster0.y1ea4k.mongodb.net/?appName=Cluster0   # read-only, web + MCP
MONGODB_URI_REQUESTS=mongodb+srv://spec_requester:<password>@cluster0.y1ea4k.mongodb.net/?appName=Cluster0   # spec_requester (readWrite on ripple.spec_requests only): web prompt box, server-side only
MONGODB_URI_AUTH=mongodb+srv://ripple_auth:<password>@cluster0.y1ea4k.mongodb.net/?appName=Cluster0   # ripple_auth (readWrite on users/accounts/sessions/verification_tokens only): Auth.js adapter, server-side only
MONGODB_DB=ripple
AUTH_SECRET=   # `npx auth secret` or any random 32+ byte value
AUTH_GITHUB_ID=   # GitHub OAuth app client id
AUTH_GITHUB_SECRET=   # GitHub OAuth app client secret
MDB_MCP_CONNECTION_STRING=   # same as MONGODB_URI_READER
OPENROUTER_API_KEY=
MODEL_CHEAP=openai/gpt-4o-mini
MODEL_STRONG=anthropic/claude-sonnet-4.5
VOYAGE_API_KEY=
VOYAGE_MODEL=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ripple
